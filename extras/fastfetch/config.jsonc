// Tsukiyo for fastfetch: a small pagoda, a quiet column of facts.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/tsukiyo-logo.txt",
    "color": {
      "1": "38;2;136;164;173",
      "2": "38;2;184;151;122",
      "3": "38;2;74;90;99"
    },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;136;164;173",
      "title": "38;2;200;196;187",
      "output": "38;2;179;176;168",
      "separator": "38;2;74;90;99"
    },
    "key": { "width": 8 },
    "bar": {
      "char": { "elapsed": "━", "total": "━" },
      "color": { "elapsed": "38;2;136;164;173", "total": "38;2;36;48;57" },
      "border": null,
      "width": 12
    },
    "percent": { "type": ["bar", "hide-others"] }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
      "color": { "user": "38;2;200;196;187", "at": "38;2;74;90;99", "host": "38;2;136;164;173" }
    },
    { "type": "custom", "format": "\u001b[38;2;36;48;57m─────────────────────" },
    { "type": "os", "key": "os", "format": "{name}" },
    { "type": "kernel", "key": "kernel", "format": "{release}" },
    { "type": "wm", "key": "wm", "format": "{pretty-name}" },
    { "type": "terminal", "key": "term", "format": "{pretty-name}" },
    { "type": "shell", "key": "shell", "format": "{pretty-name}" },
    { "type": "packages", "key": "pkgs", "format": "{all}" },
    { "type": "uptime", "key": "uptime" },
    { "type": "custom", "format": "\u001b[38;2;36;48;57m─────────────────────" },
    { "type": "memory", "key": "mem" },
    { "type": "disk", "key": "disk", "folders": "/" },
    { "type": "battery", "key": "power" },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;179;122;114m● \u001b[38;2;196;180;138m● \u001b[38;2;140;164;131m● \u001b[38;2;127;163;163m● \u001b[38;2;122;152;171m● \u001b[38;2;156;136;152m● \u001b[38;2;184;151;122m●"
    }
  ]
}
